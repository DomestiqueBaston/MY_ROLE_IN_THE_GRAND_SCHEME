; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MY ROLE IN THE GRAND SCHEME"
run/main_scene="res://SCENES/Title_Screen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="res://MRitGS.png"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/always_on_top=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/layer_1="Mouse"
window/layer_2="Card_Top"
window/layer_3="Pin"

[file_customization]

folder_colors={
"res://TRASH/": "red"
}

[layer_names]

2d_physics/layer_1="Mouse"
2d_physics/layer_2="Card_Top"
2d_physics/layer_3="Pin"
2d_physics/layer_4="Card_Detector"
2d_physics/layer_5="Interaction_Playground"
2d_physics/layer_6="Card_Bottom"

[rendering]

textures/canvas_textures/default_texture_filter=3
textures/canvas_textures/default_texture_repeat=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
