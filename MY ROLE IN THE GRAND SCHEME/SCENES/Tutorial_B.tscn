text = "[center]How to [color=#ff1c18][pulse freq=3.0 color=#ffffff64 ease=-100.0]establish the charges[/pulse][/color] ([color=#ff8864]Solid Black links[/color])![/center]

[color=#ffffff]-[/color] A [color=#ff1c18]Culprit[/color] is [color=#ff8864]linked[/color] to a [color=#ff1c18]Victim[/color].
[color=#ffffff]-[/color] An [color=#ff1c18]Accomplice[/color] is [color=#ff8864]linked[/color] to a [color=#ff1c18]Culprit[/color].
[color=#ffffff]-[/color] A [color=#ff1c18]Witness[/color] is [color=#ff8864]linked[/color] to [color=#ff1c18]another Link[/color].
[color=#ffffff]-[/color] An [color=#ff1c18]Evidence[/color] (Object) is [color=#ff8864]linked[/color] to a [color=#ff1c18]Culprit[/color]."
vertical_alignment = 1
metadata/_edit_lock_ = true

