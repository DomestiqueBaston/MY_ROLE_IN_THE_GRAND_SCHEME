[node name="Introduction" type="Label" parent="Sheet/Left_Page"]
modulate = Color(1, 1, 1, 0.882353)
custom_minimum_size = Vector2(145, 0)
layout_mode = 2
text = "There are moments when everything falls apart and there's a coldness in the air as if the world itself is holding back. There's a presence just beyond sight in the space between thoughts, hiding in plain sight. The atmosphere is charged, like something is bound to happen. as if something is being kept from you what's been buried for too long. The minutes stretch on echoing through the stillness. and there's no getting away from it. A thought that refuses to let go but it slips just out of reach. A moment approaches and everything will come undone. Time moves on, but nothing changes because it's too far gone."
horizontal_alignment = 1
autowrap_mode = 3
metadata/_edit_lock_ = true

