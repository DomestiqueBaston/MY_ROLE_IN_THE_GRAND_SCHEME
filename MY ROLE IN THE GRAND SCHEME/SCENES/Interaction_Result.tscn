text = "Meh... Look at what I've got here. After all those efforts, I somehow managed to handle the situation.
At least, I think so. Let's see if any of this is actually useful, makes sense in the end, or if it's just more noise in the chaos...


















"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3
visible_characters_behavior = 1

[node name="Dialogue" type="Control" parent="Chalkboard_Content/Chalk_Mask/Content/Report"]
visible = false
anchors_preset = 0

[node name="Positive_Report" type="VBoxContainer" parent="Chalkboard_Content/Chalk_Mask/Content/Report/Dialogue"]
layout_mode = 0
offset_top = 56.0
offset_right = 547.0
offset_bottom = 286.0

[node name="Generic_Information" type="RichTextLabel" parent="Chalkboard_Content/Chalk_Mask/Content/Report/Dialogue/Positive_Report"]
custom_minimum_size = Vector2(107, 40)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
bbcode_enabled = true
text = "[center]Well, that was intense, but I'm glad we had the conversation.
It's a lot to take in, but I know I'm capable of handling it.
Here's hoping things move in the right direction from here.
And who knows - maybe this will all turn out better than expected.[/center]"

[node name="Sleeping_PNJ" type="RichTextLabel" parent="Chalkboard_Content/Chalk_Mask/Content/Report/Dialogue/Positive_Report"]
custom_minimum_size = Vector2(107, 14)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
bbcode_enabled = true
text = "[center]That said, maybe [color=#ff8864]it wasn't such a great idea[/color] for my [color=#ff1c18]reputation[/color] to come and chat [color=#ff8864]while[/color] they were [color=#ff8864]napping[/color]...[/center]"

[node name="Critical_Success_Emo" type="RichTextLabel" parent="Chalkboard_Content/Chalk_Mask/Content/Report/Dialogue/Positive_Report"]
custom_minimum_size = Vector2(547, 20)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
bbcode_enabled = true
text = "[center]But good news is, I can feel I'm [color=#ff1c18]emotionally[/color] regaining some [color=#ff8864]confidence[/color] after that little chat session.[/center]"

