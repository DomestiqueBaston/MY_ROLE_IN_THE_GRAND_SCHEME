text = "[center]Great, just great. That conversation left me feeling like I'm in over my head. Typical.
Let's hope this doesn't turn into an even bigger disaster.
But knowing my luck, it probably will.[/center]"

[node name="Sleeping_PNJ" type="RichTextLabel" parent="Chalkboard_Content/Chalk_Mask/Content/Report/Dialogue/Negative_Report"]
