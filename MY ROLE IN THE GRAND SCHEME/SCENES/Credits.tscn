text = "     [color=#ff1c18][shake rate=10.0 level=5 connected=0]Geoff[/shake][/color]:    [color=#ff8864][shake rate=10.0 level=5 connected=0]Developper[/shake][/color].
[color=#ffffff]-[/color] Sometimes   blows  into   a  [color=#ff8864][shake rate=10.0 level=5 connected=0]tuba[/shake][/color].
[color=#ffffff]-[/color] For  sure  [color=#ff8864][shake rate=10.0 level=5 connected=0]somewhere  on  Earth[/shake][/color]!"
scroll_active = false
