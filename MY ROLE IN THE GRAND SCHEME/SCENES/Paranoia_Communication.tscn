size_flags_horizontal = 3
size_flags_vertical = 0
theme_override_constants/line_separation = 2
theme_override_styles/normal = SubResource("StyleBoxEmpty_445rt")
bbcode_enabled = true
text = "[center]Well, that was intense, but now I'm wondering if it was all just a test.
It's a lot to process, but they've probably seen it all coming.
Here's hoping things actually go right... or maybe that's exactly what they want me to think.
And who knows, maybe this will turn out better... or maybe they've already set me up for the fall.[/center]"
metadata/_edit_lock_ = true

[node name="Critical_Success_Emo" type="RichTextLabel" parent="Content/Frame_Content/Report_Margin/Report/Dialogue/Positive_Report"]
custom_minimum_size = Vector2(520, 27)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
theme_override_constants/line_separation = 2
bbcode_enabled = true
text = "[center][color=#ff8864]The good news[/color]? I can feel some [color=#ff1c18]emotional[/color] recovery... but [color=#ff8864]how much of this confidence is actually mine[/color]?
After that little chat, I'm starting to wonder if they've been [color=#ff1c18]planting thoughts in my head[/color] [color=#ff8864]all along[/color].[/center]"
metadata/_edit_lock_ = true

