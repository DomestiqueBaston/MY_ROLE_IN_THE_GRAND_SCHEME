[node name="Report" type="Label" parent="Content/Frame_Content/Report_Margin"]
modulate = Color(1, 1, 1, 0.752941)
custom_minimum_size = Vector2(1, 1)
layout_mode = 2
size_flags_vertical = 1
text = "When I walked in, I felt something, like a dead rat was nearby. Turns out, there's something dead here.
But it's not rats. It's... human.
Something went wrong here, at some point. Look at this mess!


















"
horizontal_alignment = 1
autowrap_mode = 3
visible_characters_behavior = 1
metadata/_edit_lock_ = true

