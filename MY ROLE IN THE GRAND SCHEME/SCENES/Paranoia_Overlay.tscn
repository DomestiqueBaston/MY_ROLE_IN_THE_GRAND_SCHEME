[node name="Message" type="RichTextLabel" parent="Inner_Voice/Black_BG/Replacer"]
self_modulate = Color(1, 1, 1, 0.752941)
layout_mode = 0
offset_left = 20.0
offset_right = 620.0
offset_bottom = 340.0
theme_override_constants/outline_size = 6
theme_override_constants/line_separation = -4
theme_override_fonts/normal_font = ExtResource("4_654ki")
theme_override_font_sizes/normal_font_size = 32
bbcode_enabled = true
text = "[shake rate=30 level=11 connected=0][color=#ff1c18]I got it[/color]!
[color=#ff8864]They[/color] don't  want  me  to [color=#ff8864]find  out[/color]. [color=#ff8864]They[/color] don't  want  me  to [color=#ff8864]see[/color] it.
[color=#ff1c18]I'm  on  the  right  track[/color].  [color=#ff8864]Finally[/color]!
I'll [color=#ff8864]track  them  down[/color], [color=#ff8864]find them[/color], [color=#ff1c18]show  the  world[/color].

[color=#ff8864]Wait.[/color] [color=#ff1c18]What if it's  a  trap[/color]? [color=#ff8864]They're  [color=#ff1c18]capable[/color][/color]  of  that.
[color=#ff1c18]What if they [color=#ff8864]planned[/color] it[/color]?  [color=#ff1c18]What if they [color=#ff8864]WANTED[/color] me to [color=#ff8864]find[/color] it[/color]?
No. They  know [color=#ff1c18]nothing[/color]. [color=#ff8864]They  think  I'm  too stupid[/color]... [color=#ff1c18]but  they're  wrong[/color].

But... What if they're  [color=#ff8864]ahead[/color]? Could...  [color=#ff1c18]could  they[/color]?!  They think  I'll  give up.
[color=#ff8864]No[/color].  [color=#ff1c18]No[/color]!  I  won't [color=#ff8864]give in[/color].  [color=#ff1c18]I  can't[/color].
[color=#ff1c18]They'll  regret  it.[/color]  I'll  keep  pushing.  If I stop... [color=#ff8864]I'm  a  fool[/color].
[color=#ff1c18]And  I'm  no fool[/color].

I [color=#ff8864]don't  care  anymore[/color].  [color=#ff1c18]I  don't  care[/color]!  [color=#ff1c18]I[/color]... [color=#ff1c18]DON'T[/color]... [color=#ff1c18]CARE[/color]!
Stop [color=#ff8864]eating[/color],  [color=#ff8864]sleeping[/color],  [color=#ff1c18]living[/color] - fine.  I'll [color=#ff8864]reveal  the  truth[/color]. [color=#ff1c18]I  WILL.[/color]

[color=#ff8864]No  turning  back[/color]. They won't  get  away. [color=#ff1c18]I  WILL NOT  LET  THEM.[/color]

Hey!  [color=#ff8864]You[/color],  there,  [color=#ff1c18]WHAT  DO  YOU  KNOW[/color]?![/shake]
"
horizontal_alignment = 1
vertical_alignment = 1
script = ExtResource("5_re1fv")

