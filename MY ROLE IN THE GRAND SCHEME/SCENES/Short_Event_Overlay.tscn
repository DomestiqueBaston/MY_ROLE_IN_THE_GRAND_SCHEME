offset_right = 487.0
offset_bottom = 299.0
rotation = 0.0356184
bbcode_enabled = true
text = "[center][pulse freq=3.0 color=#ffffff64 ease=-100.0][color=#ff1c18]Someone[/color][/pulse]'s  not  happy to see [pulse freq=3.0 color=#ffffff64 ease=-100.0][color=#ff1c18]you[/color][/pulse]!

[shake rate=7.0 level=5 connected=0][color=#ff8864]Not what you expected[/color][/shake]. Just  as  you approached, the  person in front  of  you [shake rate=7.0 level=5 connected=0][color=#ff8864]turns  on  you[/color][/shake].

In  an instant, the  attack  comes-swift, calculated. It's  unclear  what  led  to this, but [shake rate=7.0 level=5 connected=0][color=#ff8864]you're in  deep [color=#ff1c18]trouble[/color][/color][/shake].

Were  you the  [shake rate=7.0 level=5 connected=0][color=#ff8864]real target  all  along[/color][/shake]?[/center]"
metadata/_edit_lock_ = true

[node name="Minion_Attack" type="RichTextLabel" parent="Short_Event_Panel/Announce/Combat"]
