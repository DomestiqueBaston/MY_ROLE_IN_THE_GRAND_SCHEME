[node name="Generic_Information" type="RichTextLabel" parent="Overlays/Interaction_Result/Dialogue/Chalk/Control/Report"]
clip_contents = false
custom_minimum_size = Vector2(154, 40)
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
text = "[color=#ff8864]Well[/color], that was intense, but I'm glad we had the [color=#ff8864]discussion[/color]. And who knows, maybe this will all turn out better than expected at some point. Am I [color=#ff8864]fooling[/color] myself?

"
fit_content = true
horizontal_alignment = 1

[node name="Info" type="RichTextLabel" parent="Overlays/Interaction_Result/Dialogue/Chalk/Control/Report"]
clip_contents = false
custom_minimum_size = Vector2(107, 14)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
bbcode_enabled = true
text = "I knew I'd get [color=#ff1c18]answers[/color]. I'm starting to [color=#ff8864]know them well[/color], all those [color=#ff8864]little sewer rats[/color]..."
fit_content = true
horizontal_alignment = 1

[node name="Info_Possible_Lie" type="RichTextLabel" parent="Overlays/Interaction_Result/Dialogue/Chalk/Control/Report"]
visible = false
clip_contents = false
custom_minimum_size = Vector2(107, 14)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
bbcode_enabled = true
text = "But the thing is, [color=#ff8864]something[/color] about that story just [color=#ff1c18]doesn't sit [color=#ff8864]absolutely[/color] right[/color]. I don't know, it smells [color=#ff8864]funny[/color]."
fit_content = true
horizontal_alignment = 1

[node name="No_New_Info" type="RichTextLabel" parent="Overlays/Interaction_Result/Dialogue/Chalk/Control/Report"]
visible = false
clip_contents = false
custom_minimum_size = Vector2(107, 14)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
bbcode_enabled = true
text = "...even though [color=#ff1c18]nothing new[/color] [color=#ff8864]came up[/color]."
fit_content = true
horizontal_alignment = 1

[node name="No_Info" type="RichTextLabel" parent="Overlays/Interaction_Result/Dialogue/Chalk/Control/Report"]
visible = false
clip_contents = false
custom_minimum_size = Vector2(107, 14)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
bbcode_enabled = true
text = "I really thought that [color=#ff8864]little chat[/color] would give me [color=#ff1c18]some answers[/color], but I [color=#ff1c18]totally screwed up[/color]..."
fit_content = true
horizontal_alignment = 1

