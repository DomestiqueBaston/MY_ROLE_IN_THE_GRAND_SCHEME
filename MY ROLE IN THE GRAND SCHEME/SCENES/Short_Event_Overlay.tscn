offset_bottom = 299.0
rotation = 0.0356184
bbcode_enabled = true
text = "[center][pulse freq=3.0 color=#ffffff64 ease=-100.0][color=#ff1c18]The coward[/color][/pulse] has fled!

[shake rate=7.0 level=5 connected=0][color=#ff8864]Not exactly  a shocker[/color][/shake]. It  appears that the  mere thought  of  facing  you - or, you know,  any challenge - was simply too  much to  handle.

It's  almost  as if one  had  a sudden, [shake rate=7.0 level=5 connected=0][color=#ff8864]overwhelming  need to  [color=#ff1c18]disappear[/color][/color][/shake].

Or [shake rate=7.0 level=5 connected=0][color=#ff8864]could it  be just... [color=#ff1c18]you[/color][/color][/shake]?[/center]"
metadata/_edit_lock_ = true

[node name="NPC_Failure" type="RichTextLabel" parent="Short_Event_Panel/Announce/Dialogue"]
visible = false
layout_mode = 0
offset_left = 169.0
offset_top = 61.0
offset_right = 487.0
offset_bottom = 299.0
rotation = 0.0356184
bbcode_enabled = true
text = "[center][pulse freq=3.0 color=#ffffff64 ease=-100.0][color=#ff1c18]The bastard[/color][/pulse] tried to flee!

[shake rate=7.0 level=5 connected=0][color=#ff8864]You'd think someone would learn by now[/color][/shake].
But no, despite all the chances, they decided to turn back...
The  moment  of escape?  [shake rate=7.0 level=5 connected=0][color=#ff8864]Totally  [color=#ff1c18]missed[/color][/color][/shake].
It’s  almost  as if they were just waiting  for  the  perfect  moment...
[shake rate=7.0 level=5 connected=0][color=#ff8864]Too bad that  moment  never  came[/color][/shake].

[shake rate=7.0 level=5 connected=0][color=#ff8864]Maybe  next  time[/color][/shake], right?[/center]"
metadata/_edit_lock_ = true

