[node name="Left_Page" type="RichTextLabel" parent="Overlays/Give_Up_Case"]
offset_left = 185.94
offset_top = 75.00774
offset_right = 329.0547
offset_bottom = 280.92804
rotation = 0.02599052
theme_override_colors/default_color = Color(0.95, 0.94303334, 0.91199994, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 3
theme_override_fonts/normal_font = ExtResource("55_s8rvk")
theme_override_font_sizes/normal_font_size = 8
bbcode_enabled = true
text = "The [color=#ff8864]Administrative Services[/color] of the [color=#ff1c18]Investigation Centre[/color] acknowledge receipt of your request.

Following internal review, your name has been [color=#ff8864]withdrawn[/color] from the [color=#ff1c18]list[/color] of [color=#ff8864]active investigators[/color] attached to the [color=#ff1c18]case[/color]. This [color=#ff8864]withdrawal[/color] is effective [color=#ff1c18]immediately[/color].

It must nevertheless be noted that the complete [color=#ff1c18]administrative closure[/color] of the [color=#ff8864]file[/color], its [color=#ff8864]transfer[/color] to [color=#ff1c18]dormant status[/color], the [color=#ff8864]maintenance[/color] of [color=#ff1c18]archival traceability[/color], and the [color=#ff8864]preservation[/color] of the possibility of [color=#ff1c18]future reactivation[/color] by our [color=#ff8864]agents[/color] [color=#ff8864]generate [color=#ff1c18]processing costs[/color][/color] that [color=#ff8864]the departments[/color] are [color=#ff1c18]not[/color] in a position to [color=#ff1c18]assume[/color]."
horizontal_alignment = 1

[node name="Right_Page" type="RichTextLabel" parent="Overlays/Give_Up_Case"]
offset_left = 348.0
offset_top = 77.0
offset_right = 483.06317
offset_bottom = 279.85782
rotation = 0.01327762
theme_override_colors/default_color = Color(0.95, 0.94303334, 0.91199994, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 3
theme_override_fonts/normal_font = ExtResource("55_s8rvk")
theme_override_font_sizes/normal_font_size = 8
bbcode_enabled = true
text = "While the financial aspect may appear secondary in relation to the matters usually handled by the Centre, please rest assured that it will in no way, [color=#ff8864]even marginally[/color], [color=#ff1c18]affect the regard in which your professional standing is held[/color].

We remain at your disposal for any further information and beg you to accept, Sir or Madam, the expression of our most bureaucratic considerations.

[color=#ff1c18]Head of File Management and Continuity Unit[/color]
By [color=#ff8864]delegation[/color]

Accordingly, find here your [color=#ff8864]fixed[/color] [color=#ff1c18]administrative fee[/color]:"
horizontal_alignment = 1

