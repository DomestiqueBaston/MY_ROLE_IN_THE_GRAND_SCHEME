bbcode_enabled = true
text = "[center][pulse freq=3.0 color=#ffffff64 ease=-100.0][color=#ff1c18]You[/color][/pulse] failed to flee  ([shake rate=7.0 level=5 connected=0][color=#ff8864]pathetic[/color][/shake])!

[shake rate=7.0 level=5 connected=0][color=#ff8864]How  disappointing...[/color][/shake]
You had one job: [shake rate=7.0 level=5 connected=0][color=#ff8864]escape[/color][/shake].
But no, you chose to stay  and face it.
Was it bravery?  Or just  pure
[shake rate=7.0 level=5 connected=0][color=#ff8864]bad judgment[/color][/shake]?
In the end, you'll have to face the one who wants to [shake rate=7.0 level=5 connected=0][color=#ff8864]take good care of you...[/color][/shake]

[shake rate=7.0 level=5 connected=0][color=#ff8864]Just  [color=#ff1c18]not what  you were  hoping  for[/color] though[/color][/shake]![/center]"
