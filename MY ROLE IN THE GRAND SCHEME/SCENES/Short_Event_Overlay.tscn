rotation = 0.0356184
bbcode_enabled = true
text = "[center][pulse freq=3.0 color=#ffffff64 ease=-100.0][color=#ff1c18]You[/color][/pulse] succeeded ([color=#ff8864]against  all  odds[/color])!

[shake rate=7.0 level=5 connected=0][color=#ff8864]Well, color me surprised…[/color][/shake]
It’s  almost impressive how you managed to  pull that  off.
Did you really  think  that  would  be  your biggest  challenge  today?

[shake rate=7.0 level=5 connected=0][color=#ff8864][color=#ff1c18]Congratulations[/color],  you’ve  done it...[/color][/shake]
[shake rate=7.0 level=5 connected=0][color=#ff8864]Just  don’t get  too  used to it.[/color][/shake][/center]"
