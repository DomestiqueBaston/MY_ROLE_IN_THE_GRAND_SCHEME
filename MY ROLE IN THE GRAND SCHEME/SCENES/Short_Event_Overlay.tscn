text = "[center][pulse freq=3.0 color=#ffffff64 ease=-100.0][color=#ff1c18]You[/color][/pulse] failed to flee  ([shake rate=7.0 level=5 connected=0][color=#ff8864]pathetic[/color][/shake])!

[shake rate=7.0 level=5 connected=0][color=#ff8864]How  disappointing...[/color][/shake]
