[
  {
    "id": "NPCxxx",
    "first_name": "",  // Choisir aléatoirement un prénom et un nom dans le Noms_prenoms.json
	"name": "",  // Choisir aléatoirement un prénom et un nom dans le Noms_prenoms.json
    "sex": ["m", "f"],
    "job": "",  // Choisir aléatoirement dans le NPC_jobs.json
	"sexual_orientation": ["f", "m"],  // (homo. à 10 % chance)
    "characteristics": {
      "PHY": 0,
      "MEN": 0,
      "HEA": 0,
      "HEAnom": 0,
      "Wan": 0
    },
    "health_meter": ["no_info", "good_health", "average_health", "low_health"],  // par défaut "no_info"
    "minion": ["no", "yes"],  // peut être "yes",  par défaut "no" car minion est un status particulier (voir Nouveau_système_vXX.odt)
    "rep": 0,  // Réputation du Joueur par défaut. /!\ -3 avec un Minion !

    "status": ["victim", "culprit", "accomplice", "suspect", "witness", "none"],  // Statut réel du NPC dans l'enquête
    "couple": ["NPCxxx", "None"],  //  de 0 à 1 (hors besoin impératif pour le crime/mobile, 50% de chance d'être en couple) (homo. si Couple homo à 10 % chance).
    "friend": ["NPCxxx", "None"],  // de 0 à 2 amis (50% partagent le lieu de travail et 50% un lieu fréquenté)
    "ennemy": ["NPCxxx", "None"],  // de 0 à 2 ennemis (50% partagent le lieu de travail et 50% un lieu fréquenté)
    "acquaintance": ["NPCxxx", "None"],  // de 0 à 3 connaissances (50% partagent le lieu de travail et 50% un lieu fréquenté)
    "affair": ["None", "NPCxxx"],  // de 0 à 1 (homo. si Couple homo). Hors affaire de Adultery/Intimacy et Intimacy, alors "none"
    "debt_influence": ["NPCxxx", "None"],  // de 0 à X Creditor(s) où X est lié au nombre de coupable(s). Hors affaire de debt_influence, alors "none".
    "ideology": ["NPCxxx", "None"],  // de 0 à X où X est lié au nombre de coupable(s)+complice(s) (voir Fiche d'enquête). Hors affaire de ideology, alors "none".

    "schedule": {
      "morning": "LOCxxxIDxxx",
      "afternoon": "LOCxxxIDxxx",
      "evening": "LOCxxxIDxxx",
      "night": "LOCxxxIDxxx",
      "we_morning": "LOCxxxIDxxx",
      "we_afternoon": "LOCxxxIDxxx",
      "we_evening": "LOCxxxIDxxx",
      "we_night": "LOCxxxIDxxx"
    },
    "work_schedule": ["morning", "afternoon", "evening", "night", "we_morning", "we_afternoon", "we_evening" et "we_night"],  // 2 périodes consécutives de 4h ou night.
    "week_end": ["saturday", "sunday"],  // /!\ Si travail le week-end, alors "monday" et "tuesday"

    "home": ["LOCxxxIDxxx"],
    "work": ["LOCxxxIDxxx"],
    "hangout": ["LOCxxxIDxxx"],  // de 1 à 2 (voir liste des possibles dans Location.json avec "hangout": ["yes"])
    "hide_out": ["LOCxxxIDxxx"],  // de 0 à 1 INFO SECRETE (voir liste des possibles dans Location.json avec "hangout": ["secret"]) !

    "property": [
      {
        "object_id": "OBJxxxIDxxx",
        "location": "LOCxxxIDxxx",
        "evidence_status": ["yes", "no"]
      }
    ],  // il y en aura de 1 à 4 (incluant éventuellement une/les evidence(s) s'il n'y en a pas ailleurs de définies)

    "information_on_npc": [
      {
        "npc_id": "NPCxxx",
        "info_type": [
          {
            "type_of_link": ["acquaintance", "intimacy", "friend", "debt_influence", "ideology", "enemy"],
            "related_npcs": ["NPCxxx", "NPCxxx"]  // désigne les 2 NPCs concernés par le lien
          },
		  {
            "location": ["hangout"],
            "related_npcs": ["NPCxxx", "LOCxxxIDxxx"]  // désigne le NPC concerné par le lien ET le lieu
          },
		  {
            "object": ["OBJxxxIDxxx"],
            "related_npcs": ["NPCxxx"]  // désigne le NPC concerné par la propriété
          }
        ]
      }
    ], // 2 à 4 Informations déténues sur 1 à 2 NPCs (2 max. si 1 NPC)
	"reduced_card": false
  }
]
