[
  {
    "id": "NPCxxx",
    "name": "",  // Choisir aléatoirement un prénom et un nom dans le Noms_prenoms.json
    "sex": "m",  // ou "f" pour féminin
    "job": "",  // Choisir aléatoirement dans le NPC_jobs.json
    "characteristics": {
      "PHY": 0,
      "MEN": 0,
      "HEA": 0,
      "HEAnom": 0,
      "Wan": 0
    },
    "health_meter": "no_info",  // ultérieurement pourra aussi être "good_health", "average_health" ou "low_health"
    "minion": "no",  // peut être "yes"
    "rep": 0,  // Réputation du NPC

    "status": "victim",  // Statut réel du NPC dans l'histoire ("victim", "culprit", "accomplice", "suspect", "witness", "none")
    "witness_clue": ["NPCxxx", "LOCxxx"],  // Pour rappel, les témoins se trompent à 50% (1 fois sur 2) au départ !
    "couple": ["NPCxxx", "None"],  //  de 0 à 1 (homo. si Couple homo à 10 % chance)
    "friend": ["NPCxxx", "None"],  // de 0 à 2 amis
    "ennemy": ["NPCxxx", "None"],  // de 0 à 2 ennemis
    "acquaintance": ["NPCxxx", "None"],  // de 0 à 3 connaissances
    "affair": ["None", "NPCxxx"],  // de 0 à 1 (homo. si Couple homo)
    "debt_influence": ["NPCxxx", "None"],  // de 0 à X Creditor(s) où X est lié au nombre de coupable(s)
    "ideology": ["NPCxxx", "None"],  // de 0 à X où X est lié au nombre de coupable(s)+complice(s) (voir Fiche d'enquête)

    "schedule": {
      "morning": "LOCxxx",
      "afternoon": "LOCxxx",
      "evening": "LOCxxx",
      "night": "LOCxxx",
      "we_morning": "LOCxxx",
      "we_afternoon": "LOCxxx",
      "we_evening": "LOCxxx",
      "we_night": "LOCxxx"
    },
    "work_schedule": ["morning", "afternoon"],  // 2 périodes consécutives de 4h ou Night. Les autres choix sont : "evening", "night", "we_morning", "we_afternoon", "we_evening" et "we_night"
    "week_end": ["saturday", "sunday"],  // Si travail le week-end, alors "monday" et "tuesday"

    "home": ["LOCxxx"],
    "work": ["LOCxxx"],
    "owned_work_place": "no",  // "yes" ou "no" but probably useless...
    "hangouts": ["LOCxxx"],  // de 1 à 2
    "secret_hangout": ["LOCxxx"],  // de 0 à 1

    "property": [
      {
        "object_id": "OBJxxx",
        "location": "LOCxxx",
        "evidence_status": "yes"  // ou "no"
      }
    ],  // il y en aura de 1 à 4 (incluant éventuellement une/les evidence(s) s'il n'y en a pas ailleurs de définies)

    "information_on_npc": [
      {
        "npc_id": "NPCxxx",
        "info_type": [
          {
            "type_of_link": "acquaintance",  // ou "intimacy", "friend", "debt_influence", "ideology", "enemy"
            "related_npcs": ["NPCxxx", "NPCxxx"]  // désigne les 2 NPCs concernés par le lien
          }
        ]
      }
    ] // 2 à 4 Informations déténues sur 1 à 2 NPCs
  }
]
